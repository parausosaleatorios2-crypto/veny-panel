    end)
    
    Tele2Button.MouseButton1Click:Connect(function()
        Teleport(TeleportPosition2)
        Notify("Teleporte", "Teleportado para Posição 2", 2)
    end)
    
    Path1Button.MouseButton1Click:Connect(function() TeleportToPath(1) end)
    Path2Button.MouseButton1Click:Connect(function() TeleportToPath(2) end)
    Path3Button.MouseButton1Click:Connect(function() TeleportToPath(3) end)
    Path4Button.MouseButton1Click:Connect(function() TeleportToPath(4) end)
    NextPathButton.MouseButton1Click:Connect(function() NextPath() end)
    PrevPathButton.MouseButton1Click:Connect(function() PrevPath() end)
    
    -- Animação de entrada
    MainFrame.Transparency = 1
    
    TweenService:Create(MainFrame, TweenInfo.new(0.5), {
        Transparency = 0
    }):Play()
    
    Notify("Veny Panel", "Executado com sucesso ✔", 3)
end

-- Monitorar eventos
Players.PlayerAdded:Connect(function(player)
    player.CharacterAdded:Connect(function()
        if ESP_On then
            task.wait(1)
            AddESP(player)
        end
    end)
end)

LocalPlayer.CharacterAdded:Connect(function()
    task.wait(1)
    if ESP_On then
        DisableESP()
        EnableESP()
    end
    if Fly_On then
        DisableFly()
        EnableFly()
    end
end)

