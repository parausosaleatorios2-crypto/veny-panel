        end
    end)
    
    FlyButton.MouseButton1Click:Connect(function()
        if Fly_On then
            DisableFly()
            FlyButton.Text = "Fly: OFF"
        else
            EnableFly()
            FlyButton.Text = "Fly: ON"
        end
    end)
    
    Tele1Button.MouseButton1Click:Connect(function()
        Teleport(TeleportPosition1)
