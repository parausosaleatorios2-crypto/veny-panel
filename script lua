        end
        
        local Notification = Instance.new("Frame")
        Notification.Name = "Notification"
        Notification.Parent = ScreenGui
        Notification.Size = UDim2.new(0, 300, 0, 60)
        Notification.Position = UDim2.new(1, -310, 0, -70)
        Notification.BackgroundColor3 = Color3.new(0.05, 0.05, 0.05)
        Notification.BackgroundTransparency = 0.05
        Notification.BorderSizePixel = 0
        
        local Corner = Instance.new("UICorner")
        Corner.CornerRadius = UDim.new(0, 12)
        Corner.Parent = Notification
        
        local Stroke = Instance.new("UIStroke")
        Stroke.Color = Color3.new(0.3, 0.8, 1)
        Stroke.Transparency = 0.3
        Stroke.Thickness = 1.5
        Stroke.Parent = Notification
        
        local Gradient = Instance.new("UIGradient")
        Gradient.Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0, Color3.new(0.1, 0.1, 0.1)),
            ColorSequenceKeypoint.new(1, Color3.new(0.05, 0.05, 0.05))
        })
        Gradient.Rotation = 45
        Gradient.Parent = Notification
        
        local Icon = Instance.new("TextLabel")
        Icon.Parent = Notification
        Icon.Size = UDim2.new(0, 30, 0, 30)
        Icon.Position = UDim2.new(0, 15, 0.5, -15)
        Icon.BackgroundTransparency = 1
        Icon.Text = "✔"
        Icon.Font = Enum.Font.GothamBold
        Icon.TextSize = 20
        Icon.TextColor3 = Color3.new(0.3, 1, 0.5)
        
        local TitleLabel = Instance.new("TextLabel")
        TitleLabel.Parent = Notification
        TitleLabel.Size = UDim2.new(1, -60, 0, 20)
        TitleLabel.Position = UDim2.new(0, 55, 0, 10)
        TitleLabel.BackgroundTransparency = 1
        TitleLabel.Text = title
        TitleLabel.Font = Enum.Font.GothamBold
        TitleLabel.TextSize = 14
        TitleLabel.TextColor3 = Color3.new(1, 1, 1)
        TitleLabel.TextXAlignment = Enum.TextXAlignment.Left
        
        local MessageLabel = Instance.new("TextLabel")
        MessageLabel.Parent = Notification
        MessageLabel.Size = UDim2.new(1, -60, 0, 20)
        MessageLabel.Position = UDim2.new(0, 55, 0, 30)
        MessageLabel.BackgroundTransparency = 1
        MessageLabel.Text = message
        MessageLabel.Font = Enum.Font.Gotham
        MessageLabel.TextSize = 12
        MessageLabel.TextColor3 = Color3.new(0.7, 0.7, 0.7)
        MessageLabel.TextXAlignment = Enum.TextXAlignment.Left
        
        local existingNotifications = ScreenGui:GetChildren()
        for _, notif in pairs(existingNotifications) do
            if notif ~= Notification and notif:IsA("Frame") then
                TweenService:Create(notif, TweenInfo.new(0.3), {
                    Position = notif.Position + UDim2.new(0, 0, 0, 70)
                }):Play()
            end
        end
        
        Notification.Transparency = 1
        
        TweenService:Create(Notification, TweenInfo.new(0.5, Enum.EasingStyle.Quart), {
            Position = UDim2.new(1, -310, 1, -70),
            Transparency = 0
        }):Play()
        
        task.delay(duration, function()
            pcall(function()
                TweenService:Create(Notification, TweenInfo.new(0.5, Enum.EasingStyle.Quart), {
                    Position = UDim2.new(1, -310, 1, 10),
                    Transparency = 1
                }):Play()
                
                task.delay(0.5, function()
                    pcall(function()
                        Notification:Destroy()
                    end)
                end)
            end)
        end)
    end)
end

-- ESP Functions
local function AddESP(player)
    if player == LocalPlayer then return end
    if ESP_Highlights[player] then return end
    
    local char = player.Character
    if not char then return end
    
    pcall(function()
        local hl = Instance.new("Highlight")
        hl.FillColor = Color3.new(0, 1, 0)
        hl.FillTransparency = 0.3
        hl.OutlineColor = Color3.new(0, 1, 0)
        hl.OutlineTransparency = 0
        hl.Adornee = char
        hl.Parent = char
        ESP_Highlights[player] = hl
    end)
end

local function EnableESP()
    ESP_On = true
    for _, player in pairs(Players:GetPlayers()) do
        AddESP(player)
    end
    Notify("ESP", "Sistema de ESP ativado", 2)
end

local function DisableESP()
    ESP_On = false
    for player, hl in pairs(ESP_Highlights) do
        pcall(function() hl:Destroy() end)
        ESP_Highlights[player] = nil
    end
    Notify("ESP", "Sistema de ESP desativado", 2)
end

-- Fly Functions (Melhorado)
local function EnableFly()
    if Fly_On then return end
    Fly_On = true
    
    local char = LocalPlayer.Character
    if not char then return end
    local root = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChild("Humanoid")
    if not root or not hum then return end
    
    pcall(function()
        -- Usar BodyVelocity com força máxima
        FlyBody = Instance.new("BodyVelocity")
        FlyBody.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
        FlyBody.Velocity = Vector3.new(0, 0, 0)
        FlyBody.Parent = root
        
        FlyGyro = Instance.new("BodyGyro")
        FlyGyro.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
        FlyGyro.CFrame = root.CFrame
        FlyGyro.Parent = root
        
        -- Desativar estados que causam detecção
        hum.PlatformStand = true
        hum.JumpPower = 0
        hum.AutoRotate = false
    end)
    
    -- Loop de movimento mais suave
    task.spawn(function()
        while Fly_On do
            pcall(function()
                if FlyBody and FlyBody.Parent then
                    local dir = Vector3.new(0, 0, 0)
                    
                    if UserInputService:IsKeyDown(Enum.KeyCode.W) then
                        dir = dir + Camera.CFrame.LookVector
                    end
                    if UserInputService:IsKeyDown(Enum.KeyCode.S) then
                        dir = dir - Camera.CFrame.LookVector
                    end
                    if UserInputService:IsKeyDown(Enum.KeyCode.A) then
                        dir = dir - Camera.CFrame.RightVector
                    end
                    if UserInputService:IsKeyDown(Enum.KeyCode.D) then
                        dir = dir + Camera.CFrame.RightVector
                    end
                    if UserInputService:IsKeyDown(Enum.KeyCode.Space) then
                        dir = dir + Vector3.new(0, 1, 0)
                    end
                    if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then
                        dir = dir + Vector3.new(0, -1, 0)
                    end
                    
                    if dir.Magnitude > 0 then
                        dir = dir.Unit * FlySpeed
                    end
                    
                    FlyBody.Velocity = dir
                    FlyGyro.CFrame = Camera.CFrame
                end
            end)
            
            RunService.RenderStepped:Wait()
        end
    end)
    
    Notify("Fly", "Modo de voo ativado", 2)
end

local function DisableFly()
    Fly_On = false
    
    pcall(function()
        if FlyBody then FlyBody:Destroy() end
        if FlyGyro then FlyGyro:Destroy() end
    end)
    
    FlyBody = nil
    FlyGyro = nil
    
    local char = LocalPlayer.Character
    if char then
        local hum = char:FindFirstChild("Humanoid")
        if hum then
            hum.PlatformStand = false
            hum.JumpPower = 50
            hum.AutoRotate = true
        end
    end
    
    Notify("Fly", "Modo de voo desativado", 2)
end

-- Teleport Functions
local function Teleport(cf)
    local char = LocalPlayer.Character
    if not char then return end
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return end
    
    pcall(function()
        root.CFrame = cf
    end)
end

-- Path Functions
local function TeleportToPath(index)
    if Paths[index] then
        Teleport(Paths[index])
        CurrentPath = index
        Notify("Path Teleport", "Teleportado para o Path "..index, 2)
    end
end

local function NextPath()
    CurrentPath = CurrentPath + 1
    if CurrentPath > #Paths then CurrentPath = 1 end
    TeleportToPath(CurrentPath)
end

local function PrevPath()
    CurrentPath = CurrentPath - 1
    if CurrentPath < 1 then CurrentPath = #Paths end
    TeleportToPath(CurrentPath)
end

