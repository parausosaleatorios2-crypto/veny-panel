local function UpdateESP()
    if Settings.ESP then
        for _, player in ipairs(Players:GetPlayers()) do
            if player ~= LocalPlayer then CreateESP(player) end
        end
    else
        for player, gui in pairs(ESPObjects) do
            gui:Destroy()
            ESPObjects[player] = nil
        end
    end
end

-- Tracers (usando Frames)
local function CreateTracer(player)
    if TracerFrames[player] then return end
    local line = Instance.new("Frame")
    line.BackgroundColor3 = Color3.fromRGB(0, 255, 0)
    line.BorderSizePixel = 0
    line.AnchorPoint = Vector2.new(0.5, 0)
    line.Size = UDim2.new(0, 2, 0, 0)
    line.Visible = false
    line.ZIndex = 5
    line.Parent = UI.ScreenGui
    TracerFrames[player] = line
end

local function RemoveTracer(player)
    if TracerFrames[player] then
        TracerFrames[player]:Destroy()
        TracerFrames[player] = nil
    end
end

local function UpdateTracers()
    if not Settings.Tracers then
        for _, line in pairs(TracerFrames) do line.Visible = false end
        return
    end

    local viewport = Camera.ViewportSize
    local startX = viewport.X / 2
    local startY = viewport.Y * 0.95 -- ligeiramente abaixo do centro

    for player, line in pairs(TracerFrames) do
        local char = GetCharacter(player)
        if char and char:FindFirstChild("HumanoidRootPart") then
            local rootPos = char.HumanoidRootPart.Position
            local screenPos, onScreen = WorldToScreen(rootPos)
            if onScreen then
                local delta = screenPos - Vector2.new(startX, startY)
                local length = delta.Magnitude
                if length > 1 then
                    local angle = math.deg(math.atan2(delta.X, delta.Y))
                    line.Size = UDim2.new(0, 2, 0, length)
                    line.Position = UDim2.new(0, startX, 0, startY)
                    line.Rotation = angle
                    line.Visible = true
                else
                    line.Visible = false
                end
            else
                line.Visible = false
            end
        else
            line.Visible = false
        end
    end
end

-- FOV Circle
local function UpdateFOVCircle()
    if UI.FOVCircle then
        UI.FOVCircle.Size = UDim2.new(0, Settings.FOV * 2, 0, Settings.FOV * 2)
        UI.FOVCircle.Visible = Settings.ShowFOV
    end
end

-- Aimbot
local function GetClosestTarget()
    local bestPlayer = nil
    local bestDist = math.huge
    local center = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and IsTargetValid(player) then
            local char = GetCharacter(player)
            local pos = GetTargetPosition(char)
            if pos then
                local screenPos, onScreen = WorldToScreen(pos)
                if onScreen and IsInsideFOV(screenPos) then
                    local dist = (screenPos - center).Magnitude
                    if dist < bestDist then
                        bestDist = dist
                        bestPlayer = player
                    end
                end
            end
        end
    end
    return bestPlayer
end

local function AimAtTarget(target)
    local char = GetCharacter(target)
    if not char then return end
    local targetPos = GetTargetPosition(char)
    if not targetPos then return end

    local camCF = Camera.CFrame
    local desiredCF = CFrame.lookAt(camCF.Position, targetPos)
    local smoothFactor = 1 / Settings.Smoothness
    Camera.CFrame = camCF:Lerp(desiredCF, math.clamp(smoothFactor, 0.01, 1))
end

local function UpdateAimbot()
    if not Settings.Aimbot then
        CurrentTarget = nil
        lastNotifiedTarget = nil
        return
    end

    if Settings.Aimlock and CurrentTarget and IsTargetValid(CurrentTarget) then
        local char = GetCharacter(CurrentTarget)
        if char then
            local pos = GetTargetPosition(char)
            if pos then
                local screenPos, onScreen = WorldToScreen(pos)
                if onScreen and IsInsideFOV(screenPos) then
                    AimAtTarget(CurrentTarget)
                    return
                end
            end
        end
        CurrentTarget = nil
    end

    local newTarget = GetClosestTarget()
    if newTarget then
        CurrentTarget = newTarget
        AimAtTarget(newTarget)
        if newTarget ~= lastNotifiedTarget then
            CreateNotification("Target: " .. newTarget.Name)
            lastNotifiedTarget = newTarget
        end
    else
        if CurrentTarget then
            CreateNotification("Target Lost")
            CurrentTarget = nil
            lastNotifiedTarget = nil
        end
    end
end

