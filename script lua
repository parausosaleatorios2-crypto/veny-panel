-- Aimbot Functions
local function GetClosestTarget()
    local bestTarget = nil
    local bestDistance = math.huge

    local viewportCenter = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and IsTargetValid(player) then
            local character = GetCharacter(player)
            local targetPos = GetTargetPosition(character)
            if targetPos then
                local screenPos, onScreen = WorldToScreen(targetPos)
                if onScreen then
                    if IsInsideFOV(screenPos) then
                        local dist = (screenPos - viewportCenter).Magnitude
                        if dist < bestDistance then
                            bestDistance = dist
                            bestTarget = player
                        end
                    end
                end
            end
        end
    end

    return bestTarget
end

local function AimAtTarget(targetPlayer)
    if not targetPlayer then return end
    local character = GetCharacter(targetPlayer)
    if not character then return end
    local targetPos = GetTargetPosition(character)
    if not targetPos then return end

    local cameraCFrame = Camera.CFrame
    local desiredCFrame = CFrame.lookAt(cameraCFrame.Position, targetPos)

    -- Smoothness factor: higher = smoother (slower)
    local smoothFactor = 1 / Settings.Smoothness
    smoothFactor = math.clamp(smoothFactor, 0.01, 1)

    Camera.CFrame = cameraCFrame:Lerp(desiredCFrame, smoothFactor)
end

local function UpdateAimbot()
    if Settings.Aimbot then
        -- Determine target
        if Settings.Aimlock and CurrentTarget and IsTargetValid(CurrentTarget) then
            -- Keep current target if still valid and inside FOV
            local character = GetCharacter(CurrentTarget)
            if character then
                local targetPos = GetTargetPosition(character)
                if targetPos then
                    local screenPos, onScreen = WorldToScreen(targetPos)
                    if onScreen and IsInsideFOV(screenPos) then
                        AimAtTarget(CurrentTarget)
                        return
                    end
                end
            end
            -- Target no longer valid, clear
            CurrentTarget = nil
        end

        -- Find new closest target
        local newTarget = GetClosestTarget()
        if newTarget then
            CurrentTarget = newTarget
            AimAtTarget(newTarget)
            if newTarget ~= lastNotifiedTarget then
                CreateNotification("Target: " .. newTarget.Name)
                lastNotifiedTarget = newTarget
            end
        else
            if CurrentTarget then
                CreateNotification("Target Lost")
                CurrentTarget = nil
                lastNotifiedTarget = nil
            end
        end
    else
        CurrentTarget = nil
        lastNotifiedTarget = nil
    end
end

