-- Utility: safe find first child
local function FindFirstChild(parent, name)
    return parent and parent:FindFirstChild(name)
end

-- Utility: get character of a player
local function GetCharacter(player)
    return player and player.Character
end

-- Utility: get humanoid of a player
local function GetHumanoid(player)
    local char = GetCharacter(player)
    return char and char:FindFirstChildOfClass("Humanoid")
end

-- Utility: get target part based on settings
local function GetTargetPart(character)
    if not character then return nil end
    local targetPartName = Settings.TargetPart
    if targetPartName == "Head" then
        return character:FindFirstChild("Head") or character:FindFirstChild("HumanoidRootPart")
    elseif targetPartName == "Chest" then
        return character:FindFirstChild("UpperTorso") or character:FindFirstChild("Torso") or character:FindFirstChild("HumanoidRootPart")
    elseif targetPartName == "Neck" then
        local head = character:FindFirstChild("Head")
        local torso = character:FindFirstChild("UpperTorso") or character:FindFirstChild("Torso")
        if head and torso then
            -- Return a CFrame that is midpoint
            return CFrame.new((head.Position + torso.Position) / 2)
        else
            return head or torso or character:FindFirstChild("HumanoidRootPart")
        end
    end
    -- Fallback
    return character:FindFirstChild("Head") or character:FindFirstChild("HumanoidRootPart")
end

-- Utility: get position of target part (works for CFrame or Part)
local function GetTargetPosition(character)
    local part = GetTargetPart(character)
    if typeof(part) == "CFrame" then
        return part.Position
    elseif part and part:IsA("BasePart") then
        return part.Position
    end
    return nil
end

-- Utility: is player a valid target?
local function IsTargetValid(player)
    if player == LocalPlayer then return false end
    local character = GetCharacter(player)
    if not character then return false end
    local humanoid = GetHumanoid(player)
    if not humanoid or humanoid.Health <= 0 then return false end
    local targetPos = GetTargetPosition(character)
    if not targetPos then return false end

    -- Distance check
    if Settings.MaxDistance and Settings.MaxDistance > 0 then
        local dist = (targetPos - Camera.CFrame.Position).Magnitude
        if dist > Settings.MaxDistance then return false end
    end

    -- Team check
    if Settings.TeamCheck then
        if player.Team == LocalPlayer.Team then return false end
    end

    -- Visibility check
    if Settings.VisibilityCheck then
        local rayParams = RaycastParams.new()
        rayParams.FilterType = Enum.RaycastFilterType.Blacklist
        rayParams.FilterDescendantsInstances = {character}
        local rayDirection = (targetPos - Camera.CFrame.Position).Unit
        local rayDistance = (targetPos - Camera.CFrame.Position).Magnitude
        local rayResult = workspace:Raycast(Camera.CFrame.Position, rayDirection * rayDistance, rayParams)
        if rayResult then
            -- Something hit before reaching target -> not visible
            return false
        end
    end

    return true
end

-- Utility: get screen position of a world position
local function WorldToScreen(worldPos)
    local screenPos, onScreen = Camera:WorldToScreenPoint(worldPos)
    return Vector2.new(screenPos.X, screenPos.Y), onScreen
end

-- Utility: check if a screen position is inside FOV circle
local function IsInsideFOV(screenPos)
    if not Settings.ShowFOV and not Settings.Aimbot then return true end -- If FOV not used, always true
    local center = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    local distance = (screenPos - center).Magnitude
    return distance <= Settings.FOV
end

-- Notification system
local NotificationContainer = nil

local function CreateNotification(text)
    if not NotificationContainer then return end

    local notification = Instance.new("Frame")
    notification.Name = "Notification"
    notification.Size = UDim2.new(0, 200, 0, 30)
    notification.Position = UDim2.new(0.5, -100, 1, -40)
    notification.AnchorPoint = Vector2.new(0.5, 1)
    notification.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
    notification.BackgroundTransparency = 0.1
    notification.BorderSizePixel = 0

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 8)
    corner.Parent = notification

    local stroke = Instance.new("UIStroke")
    stroke.Color = Color3.fromRGB(0, 255, 100)
    stroke.Thickness = 1
    stroke.Transparency = 0.3
    stroke.Parent = notification

    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, 0, 1, 0)
    label.BackgroundTransparency = 1
    label.Text = text
    label.Font = Enum.Font.GothamBold
    label.TextSize = 14
    label.TextColor3 = Color3.fromRGB(255, 255, 255)
    label.TextWrapped = true
    label.Parent = notification

    notification.Parent = NotificationContainer

    -- Animate in
    notification.Position = UDim2.new(0.5, -100, 1, 30)
    local goal = UDim2.new(0.5, -100, 1, -40)
    local tweenIn = TweenService:Create(notification, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Position = goal})
    tweenIn:Play()

    -- Animate out and destroy after delay
    task.delay(3, function()
        local goalOut = UDim2.new(0.5, -100, 1, 30)
        local tweenOut = TweenService:Create(notification, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {Position = goalOut})
        tweenOut:Play()
        tweenOut.Completed:Connect(function()
            notification:Destroy()
        end)
    end)
end

-- Cleanup function
local function Cleanup()
    -- Disconnect all connections
    for _, conn in ipairs(Connections) do
        if typeof(conn) == "RBXScriptConnection" then
            conn:Disconnect()
        end
    end
    Connections = {}

    -- Remove all ESP objects
    for _, espData in pairs(ESPObjects) do
        if espData.BillboardGui then
            espData.BillboardGui:Destroy()
        end
    end
    ESPObjects = {}

    -- Remove all tracer frames
    for _, lineFrame in pairs(TracerLines) do
        if lineFrame then
            lineFrame:Destroy()
        end
    end
    TracerLines = {}

    -- Remove FOV circle
    if UI.FOVCircle then
        UI.FOVCircle:Destroy()
        UI.FOVCircle = nil
    end

    -- Reset current target
    CurrentTarget = nil
    lastNotifiedTarget = nil
end

-- ESP Functions
local function CreateESPForPlayer(player)
    if ESPObjects[player] then return end -- already exists
    local character = GetCharacter(player)
    if not character then return end
    local head = character:FindFirstChild("Head") or character:FindFirstChild("HumanoidRootPart")
    if not head then return end

    local billboard = Instance.new("BillboardGui")
    billboard.Name = "ESP_" .. player.Name
    billboard.Adornee = head
    billboard.Size = UDim2.new(0, 4, 0, 7)
    billboard.StudsOffset = Vector3.new(0, 3.5, 0) -- Center on body
    billboard.AlwaysOnTop = true
    billboard.LightInfluence = 0
    billboard.Parent = LocalPlayer.PlayerGui

    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(1, 0, 1, 0)
    frame.BackgroundTransparency = 1
    frame.BorderSizePixel = 0
    frame.Parent = billboard

    local stroke = Instance.new("UIStroke")
    stroke.Color = Color3.fromRGB(0, 255, 0)
    stroke.Thickness = 2
    stroke.Transparency = 0
    stroke.Parent = frame

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 2)
    corner.Parent = frame

    ESPObjects[player] = {
        BillboardGui = billboard,
        Frame = frame,
        Adornee = head,
    }
end

local function RemoveESPForPlayer(player)
    local espData = ESPObjects[player]
    if espData then
        espData.BillboardGui:Destroy()
        ESPObjects[player] = nil
    end
end

local function RemoveAllESP()
    for player, espData in pairs(ESPObjects) do
        if espData.BillboardGui then
            espData.BillboardGui:Destroy()
        end
        ESPObjects[player] = nil
    end
end

local function UpdateESP()
    if Settings.ESP then
        for _, player in ipairs(Players:GetPlayers()) do
            if player ~= LocalPlayer then
                CreateESPForPlayer(player)
            end
        end
    else
        RemoveAllESP()
    end
end

