-- TELEPORT SYSTEM
-- =============================================================================

-- 1. Teleporte de Fases
local function TeleportToStage(stagePart)
    if stagePart and (stagePart:IsA("BasePart") or stagePart:IsA("Model")) then
        local pos = stagePart:IsA("Model") and stagePart:GetPivot() or stagePart.Position
        SafeTeleport(pos)
    end
end

-- 2. Teleporte para a Base do Jogador
local function FindPlayerBase()
    local possibleFolders = {"Bases", "Plots", "PlayerBases", "Tycoons", "Houses"}
    for _, folderName in ipairs(possibleFolders) do
        local folder = Workspace:FindFirstChild(folderName)
        if folder then
            for _, base in ipairs(folder:GetChildren()) do
                -- Verifica se a base pertence ao jogador via Atributos ou Valores
                if base:GetAttribute("Owner") == LocalPlayer.Name or
                   base:GetAttribute("UserId") == LocalPlayer.UserId or
                   (base:FindFirstChild("Owner") and base.Owner.Value == LocalPlayer.Name) then

                    -- Procura ponto de spawn dentro da base
                    local spawnPoints = {"Spawn", "SpawnPoint", "BaseSpawn", "Entrance", "Home", "Center", "PrimaryPart"}
                    for _, spName in ipairs(spawnPoints) do
                        local sp = base:FindFirstChild(spName, true)
                        if sp and sp:IsA("BasePart") then return sp.Position end
                    end
                    return base:GetPivot().Position
                end
            end
        end
    end
    return nil
end

local function TeleportToBase()
    local basePos = FindPlayerBase()
    if basePos then
        SafeTeleport(basePos)
    else
        Rayfield:Notify({
            Title = "Erro",
            Content = "Sua base não foi encontrada automaticamente.",
            Duration = 5
        })
    end
end

-- 3. Teleporte para Ovos
local function TeleportToEgg(egg)
    if not egg then return end
    local pos = egg:IsA("Model") and egg:GetPivot() or egg.Position
    SafeTeleport(pos)
end

-- =============================================================================
-- EGG DETECTION SYSTEM
-- =============================================================================

local function IsEgg(object)
    local eggKeywords = {"Egg", "Ovo", "EggSpawn", "EggModel", "EggDrop", "RareEgg", "LegendaryEgg", "MythicEgg"}
    for _, keyword in ipairs(eggKeywords) do
        if string.find(object.Name, keyword) then return true end
    end
    return false
end

local function GetEggRarity(object)
    -- 1. Busca em Atributos
    local rarity = object:GetAttribute("Rarity") or object:GetAttribute("Tier") or object:GetAttribute("Type")
    if rarity then return rarity end

    -- 2. Busca em objetos filhos
    local rarityObj = object:FindFirstChild("Rarity") or object:FindFirstChild("Tier") or object:FindFirstChild("EggType")
    if rarityObj and (rarityObj:IsA("StringValue") or rarityObj:IsA("IntValue")) then
        return tostring(rarityObj.Value)
    end

    return "Common"
end

local function RegisterEgg(egg)
    local rarity = GetEggRarity(egg)
    local pos = egg:IsA("Model") and egg:GetPivot().Position or egg.Position

    DetectedEggs[egg] = {
        Name = egg.Name,
        Rarity = rarity,
        Position = pos,
        SpawnTime = os.date("%H:%M:%S")
    }

    -- Se for raro, atualiza o último ovo raro
    if RareEggNames[rarity] then
        LastRareEggData = {
            Object = egg,
            Name = egg.Name,
            Rarity = rarity,
            Position = pos,
            SpawnTime = os.date("%H:%M:%S")
        }

        if NotificationsEnabled then
            Rayfield:Notify({
                Title = "🥚 Rare Egg Spawned!",
                Content = string.format("Raridade: %s\nNome: %s\nHora: %s", rarity, egg.Name, LastRareEggData.SpawnTime),
                Duration = 6
            })
        end
    end
end

local function RemoveEgg(egg)
    DetectedEggs[egg] = nil
    if LastRareEggData.Object == egg then
        LastRareEggData.Object = nil
    end
end

-- Monitor de Ovos (Event-based)
local function InitializeEggMonitor()
    -- Verificação inicial
    for _, desc in ipairs(Workspace:GetDescendants()) do
        if IsEgg(desc) then RegisterEgg(desc) end
    end

    -- Monitoramento em tempo real
    Workspace.DescendantAdded:Connect(function(desc)
        task.wait(0.5) -- Espera carregar atributos
        if IsEgg(desc) then
            RegisterEgg(desc)
        end
    end)

    Workspace.DescendantRemoving:Connect(function(desc)
        RemoveEgg(desc)
    end)
end

