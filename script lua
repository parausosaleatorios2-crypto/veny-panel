-- Main initialization
local function Init()
    local screenGui = CreateUI()

    -- Initial ESP/Tracers update
    UpdateESP()
    UpdateAllTracers()
    UpdateFOVCircle()

    -- Player added
    local function OnPlayerAdded(player)
        if player ~= LocalPlayer then
            if Settings.ESP then
                CreateESPForPlayer(player)
            end
            if Settings.Tracers then
                CreateTracerForPlayer(player)
            end
        end
    end

    local function OnPlayerRemoving(player)
        if player ~= LocalPlayer then
            RemoveESPForPlayer(player)
            RemoveTracerForPlayer(player)
            if CurrentTarget == player then
                CurrentTarget = nil
                lastNotifiedTarget = nil
            end
        end
    end

    for _, player in ipairs(Players:GetPlayers()) do
        OnPlayerAdded(player)
    end

    Connections[#Connections + 1] = Players.PlayerAdded:Connect(OnPlayerAdded)
    Connections[#Connections + 1] = Players.PlayerRemoving:Connect(OnPlayerRemoving)

    -- Character added (respawn)
    local function OnCharacterAdded(player, character)
        if player ~= LocalPlayer then
            if Settings.ESP then
                RemoveESPForPlayer(player)
                task.wait(0.1)
                CreateESPForPlayer(player)
            end
            if Settings.Tracers then
                CreateTracerForPlayer(player)
            end
        end
    end

    Connections[#Connections + 1] = Players.PlayerAdded:Connect(function(player)
        player.CharacterAdded:Connect(function(character)
            OnCharacterAdded(player, character)
        end)
    end)

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            Connections[#Connections + 1] = player.CharacterAdded:Connect(function(character)
                OnCharacterAdded(player, character)
            end)
        end
    end

    -- RenderStepped for continuous updates
    local renderConnection
    renderConnection = RunService.RenderStepped:Connect(function(dt)
        UpdateTracers()
        UpdateFOVCircle()
        UpdateAimbot()
    end)
    Connections[#Connections + 1] = renderConnection

    -- Cleanup on script destruction
    screenGui.Destroying:Connect(function()
        Cleanup()
        for _, conn in ipairs(Connections) do
            conn:Disconnect()
        end
    end)
end

Init()
