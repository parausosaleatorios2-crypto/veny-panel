        Button.MouseButton1Click:Connect(function()
            TweenService:Create(Button, TweenInfo.new(0.1), {
                Size = UDim2.new(1, -10, 0, 38)
            }):Play()
            task.wait(0.1)
            TweenService:Create(Button, TweenInfo.new(0.1), {
                Size = UDim2.new(1, 0, 0, 40)
            }):Play()
        end)
        
        return Button
    end
    
    -- Criar botões
    local ESPButton = CreateGlassButton("ESP: OFF", 1)
    local FlyButton = CreateGlassButton("Fly: OFF", 2)
    
