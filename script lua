-- 1. Sistema de Fases
local function UpdateStagesList()
    AvailableStages = {}
    local foldersToSearch = {"Stages", "Checkpoints", "Areas", "Map", "Spawns", "Level", "Fases", "Stage"}

    for _, folderName in ipairs(foldersToSearch) do
        local folder = Workspace:FindFirstChild(folderName)
        if folder then
            for _, stage in ipairs(folder:GetChildren()) do
                if stage:IsA("BasePart") or stage:IsA("Model") then
                    table.insert(AvailableStages, stage.Name)
                end
            end
        end
    end
    return AvailableStages
end

-- 2. Sistema de Base
local function FindPlayerBase()
    local folders = {"Bases", "Plots", "PlayerBases", "Tycoons", "Houses", "PlayerBases"}
    for _, fName in ipairs(folders) do
        local folder = Workspace:FindFirstChild(fName)
        if folder then
            for _, base in ipairs(folder:GetChildren()) do
                -- Verifica ownership via atributos ou valores internos
                if base:GetAttribute("Owner") == LocalPlayer.Name or
                   base:GetAttribute("UserId") == LocalPlayer.UserId or
                   (base:FindFirstChild("Owner") and tostring(base.Owner.Value) == LocalPlayer.Name) or
                   (base:FindFirstChild("OwnerName") and tostring(base.OwnerName.Value) == LocalPlayer.Name) then

                    local spawnPoints = {"Spawn", "SpawnPoint", "BaseSpawn", "Entrance", "Home", "Center", "PrimaryPart"}
                    for _, spName in ipairs(spawnPoints) do
                        local sp = base:FindFirstChild(spName, true)
                        if sp and sp:IsA("BasePart") then return sp.Position end
                    end
                    return base:GetPivot().Position
                end
            end
        end
    end
    return nil
end

-- 3. Sistema de Ovos
local function IsEgg(object)
    local keywords = {"Egg", "Ovo", "EggSpawn", "EggModel", "EggDrop", "RareEgg", "LegendaryEgg"}
    for _, k in ipairs(keywords) do
        if string.find(object.Name, k) then return true end
    end
    return false
end

local function GetEggRarity(object)
    local rarity = object:GetAttribute("Rarity") or object:GetAttribute("Tier") or object:GetAttribute("Type")
    if rarity then return rarity end
    local rarityObj = object:FindFirstChild("Rarity") or object:FindFirstChild("Tier") or object:FindFirstChild("EggType")
    if rarityObj then return tostring(rarityObj.Value) end
    return "Common"
end

local function RegisterEgg(egg)
    local rarity = GetEggRarity(egg)
    local pos = egg:IsA("Model") and egg:GetPivot().Position or egg.Position
    DetectedEggs[egg] = { Name = egg.Name, Rarity = rarity, Position = pos, SpawnTime = os.date("%H:%M:%S") }

    if RareEggNames[rarity] then
        LastRareEggData = {
            Object = egg,
            Name = egg.Name,
            Rarity = rarity,
            Position = pos,
            SpawnTime = os.date("%H:%M:%S"),
            Status = "Available"
        }
        if NotificationsEnabled then
            Rayfield:Notify({
                Title = "🥚 Ovo Raro Spawnou!",
                Content = string.format("Ovo: %s\nRaridade: %s", egg.Name, rarity),
                Duration = 6
            })
        end
    end
end

local function InitializeEggMonitor()
    -- Verificação Inicial
    for _, desc in ipairs(Workspace:GetDescendants()) do
        if IsEgg(desc) then RegisterEgg(desc) end
    end

    -- Monitoramento em Tempo Real
    Workspace.DescendantAdded:Connect(function(desc)
        task.wait(0.5)
        if IsEgg(desc) then RegisterEgg(desc) end
    end)

    Workspace.DescendantRemoving:Connect(function(desc)
        if DetectedEggs[desc] then
            DetectedEggs[desc] = nil
            if LastRareEggData.Object == desc then
                LastRareEggData.Status = "Unavailable"
            end
        end
    end)
end

-- Funções de Teleporte Específicas
local function TeleportToRandomEgg()
    local eggs = {}
    for obj, _ in pairs(DetectedEggs) do table.insert(eggs, obj) end
    if #eggs == 0 then
        Rayfield:Notify({Title="Erro", Content="Nenhum ovo detectado no mapa!", Duration=3})
        return
    end
    local randomEgg = eggs[math.random(1, #eggs)]
    SafeTeleport(randomEgg:IsA("Model") and randomEgg:GetPivot() or randomEgg.Position)
end

local function TeleportToLastRareEgg()
    if LastRareEggData.Object and LastRareEggData.Status == "Available" then
        SafeTeleport(LastRareEggData.Object:IsA("Model") and LastRareEggData.Object:GetPivot() or LastRareEggData.Object.Position)
    else
        Rayfield:Notify({Title="Erro", Content="Ovo não está mais disponível!", Duration=3})
    end
end

