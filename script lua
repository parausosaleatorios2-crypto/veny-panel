local function RemoveTracerForPlayer(player)
    local lineFrame = TracerLines[player]
    if lineFrame then
        lineFrame:Destroy()
        TracerLines[player] = nil
    end
end

local function RemoveAllTracers()
    for player, lineFrame in pairs(TracerLines) do
        if lineFrame then
            lineFrame:Destroy()
        end
        TracerLines[player] = nil
    end
end

local function UpdateTracers()
    if Settings.Tracers then
        local viewport = Camera.ViewportSize
        local startX = viewport.X / 2
        local startY = viewport.Y -- bottom center (adjust if needed)
        for player, lineFrame in pairs(TracerLines) do
            local character = GetCharacter(player)
            if character and character:FindFirstChild("HumanoidRootPart") then
                local rootPos = character.HumanoidRootPart.Position
                local screenPos, onScreen = WorldToScreen(rootPos)
                if onScreen then
                    local delta = screenPos - Vector2.new(startX, startY)
                    local length = delta.Magnitude
                    if length > 0 then
                        local angle = math.deg(math.atan2(delta.X, delta.Y)) -- angle from vertical down
                        lineFrame.Size = UDim2.new(0, 2, 0, length)
                        lineFrame.Position = UDim2.new(0, startX, 0, startY)
                        lineFrame.Rotation = angle
                        lineFrame.Visible = true
                    else
                        lineFrame.Visible = false
                    end
                else
                    lineFrame.Visible = false
                end
            else
                lineFrame.Visible = false
            end
        end
    else
        -- Hide all lines
        for _, lineFrame in pairs(TracerLines) do
            if lineFrame then lineFrame.Visible = false end
        end
    end
end

local function UpdateAllTracers()
    if Settings.Tracers then
        for _, player in ipairs(Players:GetPlayers()) do
            if player ~= LocalPlayer then
                CreateTracerForPlayer(player)
            end
        end
    else
        RemoveAllTracers()
    end
end

