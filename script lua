    layout.Padding = UDim.new(0, 5)
    layout.SortOrder = Enum.SortOrder.LayoutOrder
    layout.Parent = content

    -- Container de notificações
    NotificationContainer = Instance.new("Frame")
    NotificationContainer.Size = UDim2.new(1, 0, 1, 0)
    NotificationContainer.BackgroundTransparency = 1
    NotificationContainer.ZIndex = 100
    NotificationContainer.Parent = screenGui

    -- Círculo FOV
    local fovCircle = Instance.new("Frame")
    fovCircle.AnchorPoint = Vector2.new(0.5, 0.5)
    fovCircle.Position = UDim2.new(0.5, 0, 0.5, 0)
    fovCircle.Size = UDim2.new(0, Settings.FOV * 2, 0, Settings.FOV * 2)
    fovCircle.BackgroundTransparency = 1
    fovCircle.BorderSizePixel = 0
    fovCircle.ZIndex = 3
    fovCircle.Visible = Settings.ShowFOV
    fovCircle.Parent = screenGui
    UI.FOVCircle = fovCircle

    local fovCorner = Instance.new("UICorner")
    fovCorner.CornerRadius = UDim.new(1, 0)
    fovCorner.Parent = fovCircle

    local fovStroke = Instance.new("UIStroke")
    fovStroke.Color = Color3.fromRGB(255, 255, 255)
    fovStroke.Thickness = 2
    fovStroke.Transparency = 0.7
    fovStroke.Parent = fovCircle

    -- Arrastar painel
    local dragging = false
    local dragStart = nil
    local startPos = nil

    header.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true
            dragStart = input.Position
            startPos = mainFrame.Position
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
            local delta = input.Position - dragStart
            mainFrame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
            shadow.Position = mainFrame.Position + UDim2.new(0, -5, 0, -5)
        end
    end)

    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end
    end)

    -- Minimizar
    local isMinimized = false
    minimizeBtn.MouseButton1Click:Connect(function()
        isMinimized = not isMinimized
        content.Visible = not isMinimized
        mainFrame.Size = isMinimized and UDim2.new(0, 310, 0, 40) or UDim2.new(0, 310, 0, 510)
        shadow.Size = isMinimized and UDim2.new(0, 320, 0, 50) or UDim2.new(0, 320, 0, 520)
    end)

    -- Fechar
    closeBtn.MouseButton1Click:Connect(function()
        Cleanup()
        screenGui:Destroy()
    end)

    -- Seções
    local visualsSection = Instance.new("Frame")
    visualsSection.Size = UDim2.new(1, 0, 0, 100)
    visualsSection.BackgroundTransparency = 1
    visualsSection.Parent = content

    local visualsTitle = Instance.new("TextLabel")
    visualsTitle.Size = UDim2.new(1, 0, 0, 25)
    visualsTitle.BackgroundTransparency = 1
    visualsTitle.Text = "VISUALS"
    visualsTitle.Font = Enum.Font.GothamBlack
    visualsTitle.TextSize = 15
    visualsTitle.TextColor3 = Color3.fromRGB(0, 200, 100)
    visualsTitle.TextXAlignment = Enum.TextXAlignment.Left
    visualsTitle.Parent = visualsSection

    -- ESP Toggle
    local espSetState = CreateToggle(visualsSection, "ESP", function(state)
        Settings.ESP = state
        if state then
            CreateNotification("ESP Enabled")
            UpdateESP()
        else
            CreateNotification("ESP Disabled")
            UpdateESP()
        end
    end)
    espSetState(Settings.ESP)

    -- Tracers Toggle
    local tracerSetState = CreateToggle(visualsSection, "Tracers", function(state)
        Settings.Tracers = state
        if state then
            CreateNotification("Tracers Enabled")
            -- Garantir que existam tracers para todos os jogadores
            for _, p in ipairs(Players:GetPlayers()) do
                if p ~= LocalPlayer then CreateTracer(p) end
            end
        else
            CreateNotification("Tracers Disabled")
        end
    end)
    tracerSetState(Settings.Tracers)

    -- Seção AIM
    local aimSection = Instance.new("Frame")
    aimSection.Size = UDim2.new(1, 0, 0, 400)
    aimSection.BackgroundTransparency = 1
    aimSection.Parent = content

    local aimTitle = Instance.new("TextLabel")
    aimTitle.Size = UDim2.new(1, 0, 0, 25)
    aimTitle.BackgroundTransparency = 1
    aimTitle.Text = "AIM"
    aimTitle.Font = Enum.Font.GothamBlack
    aimTitle.TextSize = 15
    aimTitle.TextColor3 = Color3.fromRGB(0, 200, 100)
    aimTitle.TextXAlignment = Enum.TextXAlignment.Left
    aimTitle.Parent = aimSection

    -- Aimbot
    local aimbotSetState = CreateToggle(aimSection, "Aimbot", function(state)
        Settings.Aimbot = state
        if state then
            CreateNotification("Aimbot Enabled")
        else
            CreateNotification("Aimbot Disabled")
            CurrentTarget = nil
            lastNotifiedTarget = nil
        end
    end)
    aimbotSetState(Settings.Aimbot)

    -- Aimlock
    local aimlockSetState = CreateToggle(aimSection, "Aimlock", function(state)
        Settings.Aimlock = state
        if state then CreateNotification("Aimlock Enabled") else CreateNotification("Aimlock Disabled") end
    end)
    aimlockSetState(Settings.Aimlock)

    -- Target Part Dropdown
    local targetPartSet = CreateDropdown(aimSection, "Target Part", {"Head", "Neck", "Chest"}, Settings.TargetPart, function(option)
        Settings.TargetPart = option
        CreateNotification("Target Part: " .. option)
    end)
    targetPartSet(Settings.TargetPart)

    -- FOV Slider
    local fovSet = CreateSlider(aimSection, "FOV Size", 20, 500, Settings.FOV, function(val)
        Settings.FOV = val
        UpdateFOVCircle()
    end)
    fovSet(Settings.FOV)

    -- Show FOV Toggle
    local showFOVSetState = CreateToggle(aimSection, "Show FOV", function(state)
        Settings.ShowFOV = state
        UpdateFOVCircle()
    end)
    showFOVSetState(Settings.ShowFOV)

    -- Aim Smoothness Slider
    local smoothSet = CreateSlider(aimSection, "Aim Smoothness", 1, 20, Settings.Smoothness, function(val)
        Settings.Smoothness = val
    end)
    smoothSet(Settings.Smoothness)

    -- Team Check Toggle
    local teamCheckSetState = CreateToggle(aimSection, "Team Check", function(state)
        Settings.TeamCheck = state
    end)
    teamCheckSetState(Settings.TeamCheck)

    -- Visibility Check Toggle
    local visCheckSetState = CreateToggle(aimSection, "Visibility Check", function(state)
        Settings.VisibilityCheck = state
    end)
    visCheckSetState(Settings.VisibilityCheck)

    -- Max Distance Slider
    local maxDistSet = CreateSlider(aimSection, "Max Distance", 50, 5000, Settings.MaxDistance, function(val)
        Settings.MaxDistance = val
    end)
    maxDistSet(Settings.MaxDistance)

    return screenGui
end

-- Inicialização
local function Init()
    local screenGui = CreateUI()

    UpdateESP()
    UpdateFOVCircle()

    -- Conectar eventos de jogadores
    local function onPlayerAdded(player)
        if player ~= LocalPlayer then
            if Settings.ESP then CreateESP(player) end
            if Settings.Tracers then CreateTracer(player) end
        end
    end

    local function onPlayerRemoving(player)
        if player ~= LocalPlayer then
            RemoveESP(player)
            RemoveTracer(player)
            if CurrentTarget == player then
                CurrentTarget = nil
                lastNotifiedTarget = nil
            end
        end
    end

    for _, p in ipairs(Players:GetPlayers()) do onPlayerAdded(p) end

    Connections[#Connections + 1] = Players.PlayerAdded:Connect(onPlayerAdded)
    Connections[#Connections + 1] = Players.PlayerRemoving:Connect(onPlayerRemoving)

    -- Respawn
    local function onCharacterAdded(player, character)
        if player ~= LocalPlayer then
            if Settings.ESP then
                RemoveESP(player)
                task.wait(0.1)
                CreateESP(player)
            end
            -- Tracers não precisam ser recriados, apenas atualizados
        end
    end

    Connections[#Connections + 1] = Players.PlayerAdded:Connect(function(player)
        player.CharacterAdded:Connect(function(char) onCharacterAdded(player, char) end)
    end)
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer then
            Connections[#Connections + 1] = p.CharacterAdded:Connect(function(char) onCharacterAdded(p, char) end)
        end
    end

    -- RenderStepped
    local renderConn
    renderConn = RunService.RenderStepped:Connect(function()
        UpdateTracers()
        UpdateFOVCircle()
        UpdateAimbot()
    end)
    Connections[#Connections + 1] = renderConn

    screenGui.Destroying:Connect(function()
        Cleanup()
    end)
end

function Cleanup()
    for _, conn in ipairs(Connections) do
        if typeof(conn) == "RBXScriptConnection" then conn:Disconnect() end
    end
    Connections = {}

    for _, gui in pairs(ESPObjects) do gui:Destroy() end
    ESPObjects = {}

    for _, line in pairs(TracerFrames) do line:Destroy() end
    TracerFrames = {}

    if UI.FOVCircle then UI.FOVCircle:Destroy(); UI.FOVCircle = nil end
    CurrentTarget = nil
    lastNotifiedTarget = nil
end

-- Executar
Init()
