local function SafeTeleport(destination)
    if not destination then return end
    local character = LocalPlayer.Character
    if not character then return end
    local hrp = character:FindFirstChild("HumanoidRootPart")
    if hrp then
        -- Teleporta ligeiramente acima para evitar prender no chão
        hrp.CFrame = typeof(destination) == "CFrame" and destination + Vector3.new(0, 3, 0) or CFrame.new(destination + Vector3.new(0, 3, 0))
    end
end

