EggsTab:CreateButton("Teleport To Last Rare Egg", function()
    if LastRareEggData.Object then SafeTeleport(LastRareEggData.Object:IsA("Model") and LastRareEggData.Object:GetPivot() or LastRareEggData.Object.Position)
    else Rayfield:Notify({Title="Erro", Content="Ovo não disponível", Duration=3}) end
end)

local EggListSection = EggsTab:CreateSection("Ovos Detectados")
local EggListDropdown = EggsTab:CreateDropdown("Lista de Ovos", {}, function() end)

-- Loop de atualização do Dropdown de Ovos
task.spawn(function()
    while true do
        local options = {}
        for obj, data in pairs(DetectedEggs) do
            table.insert(options, string.format("%s [%s]", data.Name, data.Rarity))
        end
        EggListDropdown:Set(options)
        task.wait(3)
    end
end)

EggsTab:CreateButton("Teleport To Selected Egg", function()
    local selected = EggListDropdown.CurrentValue
    if not selected then return end
    for obj, data in pairs(DetectedEggs) do
        if string.format("%s [%s]", data.Name, data.Rarity) == selected then
            SafeTeleport(obj:IsA("Model") and obj:GetPivot() or obj.Position)
            return
        end
    end
end)

